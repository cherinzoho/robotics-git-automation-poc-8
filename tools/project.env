# ============================================================
#  Zoho Robotics — Project Configuration
#  Single source of truth for tool versions AND project
#  conventions. All setup scripts read from here.
#
#  Sections:
#    1. Tool versions      — Node.js, Git, pre-commit etc.
#    2. Hook revisions     — clang-format, black, flake8 etc.
#    3. Code style         — line length, formatting
#    4. Project conventions — commit types, scopes, branches
#    5. Repository rules   — approvals, protected branches
#
#  To change a tool version:  update section 1 or 2
#  To add a commit scope:     update COMMIT_SCOPES in section 4
#  To add a branch type:      update BRANCH_TYPES in section 4
#  To change ticket format:   update TICKET_ID_PATTERN in section 4
#
#  Last updated: 2026
#  Owner: Engineering Lead
# ============================================================

# ============================================================
#  SECTION 1 — TOOL VERSIONS
# ============================================================

# ── ROS2 ─────────────────────────────────────────────────────
# Supported distros: humble, jazzy, kilted
# Check: https://docs.ros.org/en/rolling/Releases.html
ROS2_DISTRO=humble

# ── Node.js ──────────────────────────────────────────────────
# LTS versions only (even numbers: 20, 22, 24)
# Check: https://nodejs.org/en/about/releases
NODE_MAJOR_VERSION=24

# ── Git ───────────────────────────────────────────────────────
# Minimum version for git switch (introduced in 2.23)
GIT_MIN_VERSION=2.23

# ── pre-commit ───────────────────────────────────────────────
# Minimum major version
PRECOMMIT_MIN_VERSION=3

# ── pipx ─────────────────────────────────────────────────────
PIPX_MIN_VERSION=1

# ── npm packages ─────────────────────────────────────────────
COMMITLINT_CLI_VERSION=^19.0.0
COMMITLINT_CONFIG_VERSION=^19.0.0
HUSKY_VERSION=^9.0.0

# ============================================================
#  SECTION 2 — PRE-COMMIT HOOK REVISIONS
#  To check if outdated: pre-commit autoupdate --dry-run
#  To update all:        pre-commit autoupdate
#  Then update values below and commit:
#    git add tools/project.env .pre-commit-config.yaml
#    git commit -m "chore(repo): update pre-commit hook revisions"
# ============================================================

PRECOMMIT_HOOKS_REV=v4.6.0
CLANG_FORMAT_REV=v14.0.6
BLACK_REV=23.11.0
FLAKE8_REV=6.1.0

# ============================================================
#  SECTION 3 — CODE STYLE
# ============================================================

# clang-format major version — must match CLANG_FORMAT_REV above
CLANG_FORMAT_VERSION=14

# Minimum Python version for pre-commit hooks
PYTHON_MIN_VERSION=3.8

# Maximum line length enforced by clang-format and flake8
MAX_LINE_LENGTH=100

# ============================================================
#  SECTION 4 — PROJECT CONVENTIONS
#  Edit these to adapt the automation to any project.
#  Changes here propagate automatically to:
#    commitlint.config.js   (on next setup_repo_automation.sh run)
#    .husky/pre-push        (on next setup_repo_automation.sh run)
#    .github/workflows/     (on next setup_repo_automation.sh run)
# ============================================================

# ── Commit types ─────────────────────────────────────────────
# Comma-separated. These are the allowed types in commit messages
# and PR titles: type(scope): description
#
# Standard types — do not remove:
#   feat fix refactor test ci docs chore build
# Robotics-specific additions:
#   sim → Gazebo simulation work
COMMIT_TYPES=feat,fix,refactor,test,sim,ci,docs,chore,build

# ── Commit scopes ────────────────────────────────────────────
# Format: scope:description  (description used as comment in config)
# The 'repo' and 'ci' scopes are mandatory — do not remove.
# Add your project's subsystems here.
#
# Zoho Robotics scopes:
COMMIT_SCOPES="arm:robotic arm,amr:autonomous mobile robot,humanoid:humanoid robot,sim:Gazebo simulation,nav:navigation stack,slam:SLAM and mapping,perception:sensor processing,control:control systems,hw:hardware and firmware,sdk:SDK and interfaces,infra:server infrastructure,docs:documentation,ci:CI/CD pipeline files,repo:repository config files"

# ── Subject line length ───────────────────────────────────────
# Maximum characters for commit subject line
# 72 is the git convention — keeps subject readable in log
COMMIT_SUBJECT_MAX_LENGTH=72

# ── Branch types ─────────────────────────────────────────────
# Comma-separated. Defines valid branch name prefixes.
# Each creates branches like: type/TICKET-ID-description
#
# Special handling (always present regardless of this list):
#   release    → release/1.4.0  (version number format)
#   experiment → experiment/topic-name  (no ticket ID required)
#
# Standard types — do not remove:
#   feature bugfix hotfix refactor experiment
# Robotics-specific additions:
#   sim → Gazebo simulation scenarios
BRANCH_TYPES=feature,bugfix,hotfix,refactor,sim,experiment

# ── Stale branch threshold ────────────────────────────────────
# Number of days of inactivity before a branch is flagged as stale
# Applies to feature/*, bugfix/*, refactor/*, sim/*, experiment/*
STALE_BRANCH_DAYS=60

# ── Ticket ID pattern ─────────────────────────────────────────
# Regex pattern for ticket/issue ID in branch names and PR body
#
# Format examples by issue tracker:
#   Jira:          [A-Z]+-[0-9]+           e.g. ARM-42, PROJ-123
#   Zoho Sprints:  [A-Z]+-[0-9]+           e.g. ROBOTIC-42
#   Sprint IDs:    [A-Z][A-Z0-9]*-[0-9]+   e.g. S3-42, SPRINT3-99
#   GitHub issues: GH-[0-9]+               e.g. GH-42
#   Azure DevOps:  AB#[0-9]+               e.g. AB#1234
#   Linear:        [A-Z]+-[0-9]+           e.g. ENG-42
TICKET_ID_PATTERN=[A-Z][A-Z0-9]*-[0-9]+

# ── PR body ticket keywords ───────────────────────────────────
# Comma-separated keywords accepted before the ticket reference
# GitHub auto-closes issues when these keywords are used:
#   closes, fixes — closes the issue when PR is merged
#   relates to    — links without closing
TICKET_KEYWORDS="closes|fixes|relates to"

# ── Example ticket ID ─────────────────────────────────────────
# Used in error messages and documentation to show valid formats
# Change this to match your team's actual ticket ID format
EXAMPLE_TICKET_ID=ARM-42

# ============================================================
#  SECTION 5 — REPOSITORY RULES
#  These control branch protection and review requirements.
#  GitHub-specific values used by add_status_checks.sh
# ============================================================

# ── Protected branches ────────────────────────────────────────
# Comma-separated. Branch protection is configured for these.
# Changing this requires re-running add_status_checks.sh
PROTECTED_BRANCHES=develop,main

# ── Required approvals ────────────────────────────────────────
# Minimum approvals before a PR can be merged
REQUIRED_APPROVALS_DEVELOP=1
REQUIRED_APPROVALS_MAIN=2

# ── Status check names ────────────────────────────────────────
# These must exactly match the name: fields in .github/workflows/
# Used by add_status_checks.sh to configure required checks
STATUS_CHECK_BRANCH_NAME="Branch Name Check"
STATUS_CHECK_PR_TITLE="PR Title Check"
STATUS_CHECK_PR_TICKET="PR Ticket Reference Check"
STATUS_CHECK_CPP_FORMAT="C++ Format Check"
STATUS_CHECK_PYTHON_STYLE="Python Style Check"

# ============================================================
#  SECTION 6 — WORKFLOW AND CI CONFIGURATION
# ============================================================

# ── GitHub Actions runner images ─────────────────────────────
# Image for general workflow jobs
CI_RUNNER_GENERAL=ubuntu-latest
# Image for C++/Python style checks (pinned for tool availability)
CI_RUNNER_LINT=ubuntu-22.04

# ── Stale branch cron schedule ───────────────────────────────
# When to run the stale branch check workflow
# Default: Every Monday at 8am UTC
# Format: minute hour day-of-month month day-of-week
STALE_BRANCH_CRON="0 8 * * 1"

# ── Maximum bag file size ─────────────────────────────────────
# Largest file allowed to be committed (in KB)
# ROS2 bag files are blocked separately — this covers other large files
MAX_FILE_SIZE_KB=5120

# ── Workflow job names ────────────────────────────────────────
# These must exactly match STATUS_CHECK_* values in Section 5
# They appear as the display name in GitHub Actions UI
# Changing these requires updating STATUS_CHECK_* in Section 5 too
WORKFLOW_JOB_BRANCH_NAME="Branch Name Check"
WORKFLOW_JOB_PR_TITLE="PR Title Check"
WORKFLOW_JOB_PR_TICKET="PR Ticket Reference Check"
WORKFLOW_JOB_CPP_FORMAT="C++ Format Check"
WORKFLOW_JOB_PYTHON_STYLE="Python Style Check"

# ── Trigger branch for workflow registration ──────────────────
# Temporary branch created by add_status_checks.sh to trigger
# GitHub Actions for the first time (deleted after use)
WORKFLOW_TRIGGER_BRANCH=experiment/register-workflow-checks

# ── Test commit messages used by hook tests ───────────────────
# BAD message — must be rejected by commitlint
# Must NOT match any valid type(scope): format
TEST_COMMIT_BAD="fix stuff"
# GOOD message — must pass commitlint and pre-commit
# Must use a valid type and scope from project.env
TEST_COMMIT_GOOD="chore(repo): verify automation hooks are active"

# ============================================================
#  SECTION 7 — BRANCH NAMES
# ============================================================

# ── Integration and release branch names ─────────────────────
# These are the two permanent branches in the repository.
# INTEGRATION_BRANCH: where all feature work is merged into
# RELEASE_BRANCH: production-ready code, only receives releases
# These must match the first two values in PROTECTED_BRANCHES
INTEGRATION_BRANCH_NAME=develop
RELEASE_BRANCH_NAME=main

# ── Default branch for new repositories ──────────────────────
# GitHub creates repositories with this branch name
DEFAULT_BRANCH_NAME=main
